# ============================================================
# 飞书项目管理系统 — 部署环境变量
# 复制为 .env 后按需填写。变量名与 backend/core/config.py 一致。
# ============================================================

# ---- 应用基础 ----
APP_NAME=Feishu Project Manager
APP_VERSION=1.0.0
DEBUG=False

# ---- 数据库 ----
# 容器内数据卷挂载在 /data，使用绝对路径（注意 sqlite 是 4 个斜杠）
DATABASE_URL=sqlite:////data/feishu_pm.db

# ---- JWT 安全 ----
# 必须修改！生成方式：openssl rand -hex 32  或  python -c "import secrets; print(secrets.token_hex(32))"
# 要求至少 32 字符，且不得包含默认占位词
SECRET_KEY=REPLACE_WITH_A_RANDOM_64_CHAR_HEX_STRING_AT_LEAST_32_CHARS_LONG
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 飞书应用 ----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# OAuth 回调地址，需与飞书开放平台配置一致
FEISHU_REDIRECT_URI=http://localhost/api/v1/auth/feishu/callback
# 事件订阅（如启用 Webhook / 消息加密则填写）
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ---- 飞书消息通知（安全闸，默认关闭；置 True 才会真实外发）----
FEISHU_NOTIFY_ENABLED=False

# ---- 飞书多维表格同步（可选）----
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_PROJECT_TABLE_ID=
FEISHU_BITABLE_TASK_TABLE_ID=

# ---- 定时任务（安全闸，默认关闭；置 True 才会启动后台调度）----
SCHEDULER_ENABLED=False
FEISHU_REPORT_RECEIVER_ID=

# ---- 前端地址（用于 CORS）----
FRONTEND_URL=http://localhost

# ---- 系统 ----
TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

# ---- 周会自动开启（基础设施开关）----
# 设为 True 让“每周四自动开周会”的后台任务常驻调度器；
# 实际启停由「系统设置 › 其他设置 › 周会自动开启」UI 开关控制（改后立即生效，无需重启）
AUTO_OPEN_MEETING_ENABLED=True
