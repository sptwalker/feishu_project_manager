# ============================================================
# 营销销售部实例 — 部署环境变量（子域名 sales.youdoogo.com）
# 复制为 .env.sales 后填写真实值。变量名与 backend/core/config.py 一致。
# 仅列出「与产品实例必须不同」的项 + 品牌差异化；其余沿用默认。
# ============================================================

APP_NAME=Sales Project Manager
DEBUG=False

# ---- 数据库（容器内路径相同，但挂的是独立卷 sales_data → 物理隔离）----
DATABASE_URL=sqlite:////data/feishu_pm.db
# 图片上传目录（随 sales_data 卷持久化）
UPLOAD_DIR=/data/uploads

# ---- JWT（必须与产品实例不同！否则 token 互认 = 越权）----
# 生成：openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_64_CHAR_HEX_FROM_PMS

# ---- 飞书应用（营销部自己的应用凭证）----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://sales.youdoogo.com/api/v1/auth/feishu/callback
FEISHU_NOTIFY_ENABLED=False

# ---- 初始管理员（营销负责人的飞书 open_id，JSON 数组）----
INITIAL_ADMIN_FEISHU_IDS=["ou_REPLACE_WITH_SALES_ADMIN_OPENID"]

# ---- 地址（CORS + 通知跳转链接）----
FRONTEND_URL=https://sales.youdoogo.com
SYSTEM_PUBLIC_URL=https://sales.youdoogo.com/

# ---- 周会周期（如与产品不同，可调；周会基准次数在系统设置 UI 改，随库独立）----
NEW_CYCLE_DAYS=3

# ---- 系统 ----
TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
AUTO_OPEN_MEETING_ENABLED=True

# ---- 内部销售码管理平台（仅本 sales 实例开启；产品 pms 实例不设此项=默认关）----
SALES_CODE_ENABLED=True

# ============================================================
# 品牌/表现差异化（white-label）——这套实例的 logo / 标题 / 配色 / 信息文字
# 文字支持 HTML（class="accent" 高亮，仅本配置可信）。图片由 Nginx /branding/ 提供。
# 示例：营销部用「橙色」主题。按需替换。
# ============================================================
BRAND_SIDEBAR=<span class="brand-accent">P</span>roject <span class="brand-accent">M</span>anager
BRAND_LOGIN=营销<span class="accent">PM</span>
BRAND_MARK=销
BRAND_PAGE_TITLE=营销销售项目管理系统
BRAND_LOGIN_HEADLINE=把营销项目<br />推进得<span class="accent">高效</span>。
BRAND_LOGIN_SUB=线索 · 活动 · 渠道 · 业绩 —— 一处掌握全局。
# 首页副标题口径：营销销售部 / 团队（默认产品方为 全公司 / 部门）
BRAND_ORG_SCOPE=营销销售部
BRAND_DEPT_UNIT=团队
# logo / favicon：把图片放到服务器 ./branding/sales/ 下（见 docker-compose 挂载）
BRAND_LOGO_URL=/branding/logo.png
BRAND_FAVICON_URL=/branding/favicon.svg
# 主题色（橙）。留空的项沿用产品默认蓝
BRAND_ACCENT=#e8833a
BRAND_ACCENT_HOVER=#d9742a
BRAND_ACCENT_SOFT=#faecd9
BRAND_SIDEBAR_BG=#241a12
BRAND_SIDEBAR_HOVER=#33271b
